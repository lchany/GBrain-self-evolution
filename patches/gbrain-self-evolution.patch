diff --git a/src/mcp/param-validation.ts b/src/mcp/param-validation.ts
new file mode 100644
index 0000000..f50c7cb
--- /dev/null
+++ b/src/mcp/param-validation.ts
@@ -0,0 +1,63 @@
+import type { Operation } from '../core/operations.ts';
+
+function validateParamValue(key: string, def: Operation['params'][string], val: unknown): string | null {
+  const expected = def.type;
+  if (expected === 'string' && typeof val !== 'string') return `Parameter "${key}" must be a string`;
+  if (expected === 'number' && typeof val !== 'number') return `Parameter "${key}" must be a number`;
+  if (expected === 'boolean' && typeof val !== 'boolean') return `Parameter "${key}" must be a boolean`;
+  if (expected === 'object' && (typeof val !== 'object' || Array.isArray(val))) return `Parameter "${key}" must be an object`;
+  if (expected === 'array' && !Array.isArray(val)) return `Parameter "${key}" must be an array`;
+
+  if (typeof val === 'string') {
+    if (def.enum && !def.enum.includes(val)) {
+      return `Parameter "${key}" must be one of: ${def.enum.join(', ')}`;
+    }
+    if (def.minLength !== undefined && val.length < def.minLength) {
+      return `Parameter "${key}" must be at least ${def.minLength} character(s)`;
+    }
+    if (def.maxLength !== undefined && val.length > def.maxLength) {
+      return `Parameter "${key}" must be at most ${def.maxLength} character(s)`;
+    }
+    if (def.pattern && !new RegExp(def.pattern).test(val)) {
+      const expectedPattern = def.patternDescription ?? `match ${def.pattern}`;
+      return `Parameter "${key}" must be a ${expectedPattern}`;
+    }
+  }
+
+  if (typeof val === 'number') {
+    if (!Number.isFinite(val)) return `Parameter "${key}" must be a finite number`;
+    if (def.integer === true && !Number.isInteger(val)) return `Parameter "${key}" must be an integer`;
+    if (def.minimum !== undefined && val < def.minimum) return `Parameter "${key}" must be >= ${def.minimum}`;
+    if (def.maximum !== undefined && val > def.maximum) return `Parameter "${key}" must be <= ${def.maximum}`;
+  }
+
+  if (Array.isArray(val)) {
+    if (def.minItems !== undefined && val.length < def.minItems) {
+      return `Parameter "${key}" must contain at least ${def.minItems} item(s)`;
+    }
+    if (def.maxItems !== undefined && val.length > def.maxItems) {
+      return `Parameter "${key}" must contain at most ${def.maxItems} item(s)`;
+    }
+    if (def.items) {
+      for (let i = 0; i < val.length; i += 1) {
+        const itemError = validateParamValue(`${key}[${i}]`, def.items, val[i]);
+        if (itemError) return itemError;
+      }
+    }
+  }
+
+  return null;
+}
+
+export function validateParams(op: Operation, params: Record<string, unknown>): string | null {
+  for (const [key, def] of Object.entries(op.params)) {
+    if (def.required && (params[key] === undefined || params[key] === null)) {
+      return `Missing required parameter: ${key}`;
+    }
+    if (params[key] !== undefined && params[key] !== null) {
+      const error = validateParamValue(key, def, params[key]);
+      if (error) return error;
+    }
+  }
+  return null;
+}
