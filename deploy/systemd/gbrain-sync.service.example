# GBrain 增量同步 oneshot 服务模板。
# 安装步骤：
#   sudo install -m 0644 gbrain-sync.service.example /etc/systemd/system/gbrain-sync.service
#   sudo install -m 0600 -o root -g gbrain ../env/gbrain-maintenance.env.example /etc/gbrain/gbrain-maintenance.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gbrain-sync.timer
# 环境文件必须是 root 可读、0600；不要把真实 token、secret、DATABASE_URL 写进 unit 或证据。

[Unit]
Description=GBrain scheduled incremental sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 默认使用专用低权限账号；该账号需能读取 GBRAIN_REPO 并调用 /usr/local/bin/gbrain。
User=gbrain
Group=gbrain
WorkingDirectory=/opt/gbrain
EnvironmentFile=/etc/gbrain/gbrain-maintenance.env

# 周期任务保持增量同步；全量 sync 只应在人工恢复或审计流程中显式执行。
ExecStart=/usr/local/bin/gbrain sync --repo ${GBRAIN_REPO} --no-pull --no-embed --yes

# oneshot 失败交给 timer 和 journald 暴露，不自动重启，避免重复摄取。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gbrain-sync

# 加固建议：上线前逐项验证；同步需要写入 GBrain 状态时，只放开必要路径。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/gbrain /opt/gbrain-knowledge /var/lib/gbrain /run/gbrain

[Install]
WantedBy=multi-user.target
