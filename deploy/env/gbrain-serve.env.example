# /etc/gbrain/gbrain-serve.env
# 安装后权限必须为 0600，属主 root，属组可设为 gbrain。这里只保留占位值。

GBRAIN_HTTP_PORT=3131

# 可设为 "--bind <BIND_ADDRESS>"；留空表示使用 `gbrain serve` 默认绑定。
GBRAIN_HTTP_BIND_FLAGS=

# 供操作文档和反向代理配置记录公网入口；不要填真实主机名后提交。
GBRAIN_PUBLIC_URL=https://<PUBLIC_GBRAIN_HOST>

# 审核写操作固定连接同机 MCP，不从公网 issuer、Host 或浏览器地址推导。
GBRAIN_REVIEW_WRITER_MCP_URL=http://127.0.0.1:3131/mcp

# 非 systemd 部署可显式指定 writer env；systemd 部署使用 LoadCredential。
# GBRAIN_REVIEW_WRITER_ENV_PATH=/secure/path/local-writer.env
