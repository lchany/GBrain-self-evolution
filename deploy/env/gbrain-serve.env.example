# Copy to /etc/gbrain/gbrain-serve.env and chmod 0600.
# Values below are placeholders; do not commit real credentials or hostnames.

GBRAIN_HTTP_PORT=3131
GBRAIN_HTTP_BIND=127.0.0.1
GBRAIN_PUBLIC_URL=https://<PUBLIC_GBRAIN_HOST>
GBRAIN_ADMIN_BASIC_USER=<ADMIN_USER>
GBRAIN_ADMIN_BASIC_PASSWORD=<HIGH_ENTROPY_ADMIN_PASSWORD>
GBRAIN_ADMIN_ORIGIN=https://<PUBLIC_GBRAIN_HOST>
